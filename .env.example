# Copy this file to .env and fill in your values
# The local WordPress site URL from Local by Flywheel
VITE_WP_API_URL=http://orourke-audio.local/wp-json

# Set to "true" to use mock data instead of hitting the WP API
VITE_USE_MOCK_DATA=false

# Direct URL to the hero reel video (copy straight from the WP Media Library
# file's URL field, e.g. http://orourke-audio.local/wp-content/uploads/2026/07/reel.mp4).
# Leave blank to show the poster image with no video.
VITE_HERO_VIDEO_URL=
